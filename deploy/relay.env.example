# kremote relay — environment (copy to /etc/kremote/relay.env on the VPS)
# setup-vps.sh writes a minimal version of this automatically.

# ── Network ────────────────────────────────────────────────────────────────
KREMOTE_RELAY_HOST=0.0.0.0
KREMOTE_RELAY_PORT=443

# ── TLS (enables wss:// + cert hot-reload) ──────────────────────────────────
# Point these at the copies the certbot renewal hook drops into /etc/kremote/tls.
KREMOTE_TLS_CERT=/etc/kremote/tls/fullchain.pem
KREMOTE_TLS_KEY=/etc/kremote/tls/privkey.pem

# ── State ───────────────────────────────────────────────────────────────────
# Holds store.json (hashed device keys + session tokens). Must be writable.
KREMOTE_RELAY_HOME=/home/kremote/.kremote-relay

# ── Abuse guard (safe defaults; override only if needed) ────────────────────
# KREMOTE_MAX_CONNS_PER_IP=20
# KREMOTE_MAX_CONNS=200
# KREMOTE_AUTH_FAIL_MAX=10
# KREMOTE_AUTH_FAIL_WINDOW_MS=60000
# KREMOTE_BLOCK_MS=300000
# KREMOTE_HELLO_TIMEOUT_MS=10000
# KREMOTE_MAX_PAYLOAD=8388608
