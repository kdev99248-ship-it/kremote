# kremote deploy config — copy to deploy.env and fill in.
#   cp deploy/deploy.env.example deploy/deploy.env
#
# All three scripts (setup-vps.sh, update.sh, deploy.sh) source deploy.env if
# present. Uses `:=` (assign only if unset), so a variable passed on the command
# line still wins:  DOMAIN=other.host bash deploy/setup-vps.sh
#
# deploy.env is gitignored (it holds your email) — only this .example is committed.

# ── Required for provisioning (setup-vps.sh) ────────────────────────────────
: "${DOMAIN:=kremote.cc}"                 # domain with an A record → the VPS IP
: "${EMAIL:=you@example.com}"             # Let's Encrypt account (expiry warnings)

# ── Where the relay lives / which code to run ───────────────────────────────
: "${REPO:=https://github.com/kdev99248-ship-it/kremote.git}"
: "${BRANCH:=feat/terminal-mvp}"
: "${APP_DIR:=/opt/kremote}"
: "${TLS_DIR:=/etc/kremote/tls}"
: "${SVC_USER:=kremote}"

# ── Only needed by deploy.sh (run from your dev machine) ────────────────────
: "${VPS:=root@163.61.73.198}"           # user@host for ssh
