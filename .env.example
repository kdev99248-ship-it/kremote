# Copy to .env and adjust — .env is gitignored and never committed.
# Everything below is optional; the defaults are shown.

# ── relay (packages/relay) ─────────────────────────────────
# Bind address (default 127.0.0.1). Use 0.0.0.0 on a VPS / for LAN phone testing.
#KREMOTE_RELAY_HOST=127.0.0.1
# Listen port (default 8787)
#KREMOTE_RELAY_PORT=8787
# Public base URL for the ?key= login link the agent prints, e.g. https://kremote.example.com
#KREMOTE_PUBLIC_URL=
# Where the relay keeps store.json (device-key hashes, sessions). Default ~/.kremote-relay
#KREMOTE_RELAY_HOME=

# ── agent (packages/agent) ─────────────────────────────────
# Path to the agent config JSON. Default ~/.kremote/config.json
#KREMOTE_AGENT_CONFIG=
# Root the agent's fs.*/git.* ops are jailed to (overrides config "root"). Default: config root, else homedir
#KREMOTE_AGENT_ROOT=
